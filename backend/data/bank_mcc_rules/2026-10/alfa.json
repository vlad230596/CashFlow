 "conditions": [
  {
   "kind": "program_rule",
   "operator": null,
   "value": null,
   "originalText": "Повышенный кэшбэк начисляется только после выбора категории"
  },
  {
   "kind": "program_rule",
   "operator": null,
   "value": null,
   "originalText": "Лимит в месяц (все карты вне Alfa Only и А-Клуб): 5 000 ₽, или 7 000 ₽ с подпиской Альфа-Смарт"
  },
  {
   "kind": "program_rule",
   "operator": null,
   "value": null,
   "originalText": "Лимит в месяц, Alfa Only: 30 000 ₽; А-Клуб: 30 000 или 200 000 баллов (до 50 000 в категории) с Керамической картой/Платёжным кольцом"
  },
  {
   "kind": "program_rule",
   "operator": null,
   "value": null,
   "originalText": "Лимит в сервисах в месяц: 5 000 ₽ / 10 000 ₽ со Смарт; Alfa Only 50 000 ₽; А-Клуб без ограничений"
  },
  {
   "kind": "program_rule",
   "operator": null,
   "value": null,
   "originalText": "Кэшбэк в категориях суммируется с суперкэшбэком Барабана и с базовой ставкой сервиса (Тревел, Афиша, Заправки)"
  },
  {
   "kind": "program_rule",
   "operator": null,
   "value": null,
   "originalText": "Альфа-Пятница не суммируется с Барабаном и выбранной категорией; итог не больше 100%"
  },
  {
   "kind": "program_rule",
   "operator": null,
   "value": null,
   "originalText": "Не учитываются операции свыше 100 000 ₽ (Alfa Only — 500 000 ₽, А-Клуб — 1 000 000 ₽)"
  },
  {
   "kind": "program_rule",
   "operator": null,
   "value": null,
   "originalText": "Сноски: MCC 3990 — по сервисам экосистемы Яндекс, 3991 — Сбер, 3992 — Газпром"
  },
  {
   "kind": "exclusion_text",
   "operator": null,
   "value": null,
   "originalText": "Казино и тотализаторы, лотереи и облигации, паевые фонды и ломбарды, финансовые организации"
  },
  {
   "kind": "exclusion_text",
   "operator": null,
   "value": null,
   "originalText": "Штрафы, налоги, судебные выплаты, госуслуги, ЖКУ, связь и интернет, транспортные карты — если не выбрана соответствующая категория"
  },
  {
   "kind": "exclusion_text",
   "operator": null,
   "value": null,
   "originalText": "Страховые компании; продажа средств связи"
  },
  {
   "kind": "exclusion_text",
   "operator": null,
   "value": null,
   "originalText": "Коммерческие операции: оплата для юрлиц, курьеры и агентства по отправке грузов, прямой маркетинг"
  },
  {
   "kind": "exclusion_text",
   "operator": null,
   "value": null,
   "originalText": "Яндекс Сплит, Подели, Долями, Cash at POS"
  },
  {
   "kind": "exclusion_text",
   "operator": null,
   "value": null,
   "originalText": "Снятие наличных, комиссии банка, переводы на счета/карты, пополнение электронных кошельков, платежи по залогам и облигациям"
  },
  {
   "kind": "exclusion_text",
   "operator": null,
   "value": null,
   "originalText": "При категориях «За все покупки», «Через Alfa Pay», «По Альфа-Стикеру» нет кэшбэка за Яндекс Еду, Деливери и Яндекс Лавку"
  },
