 "conditions": [
  {
   "kind": "program_rule",
   "operator": null,
   "value": null,
   "originalText": "Бонусы за каждые полные 100 ₽ покупки в выбранных категориях"
  },
  {
   "kind": "program_rule",
   "operator": null,
   "value": null,
   "originalText": "Категории выбираются каждый месяц; их число зависит от продуктов Сбера (карты, подписки, пакеты)"
  },
  {
   "kind": "program_rule",
   "operator": null,
   "value": null,
   "originalText": "Категория определяется по MCC или по способу оплаты (улыбка, SberPay NFC, Вжух)"
  },
  {
   "kind": "program_rule",
   "operator": null,
   "value": null,
   "originalText": "Лимит в месяц по продукту: 2 000 (Standard/Classic/Gold, СберКарта) — 5 000 (Platinum, кредитная, СберПрайм Старт) — 10 000 (СберПрайм) — 15 000 (СберПрайм+) — 20 000–50 000 (Премиальное обслуживание, СберПервый) — без лимита (Private Banking, Премиальное 5–6)"
  },
  {
   "kind": "program_rule",
   "operator": null,
   "value": null,
   "originalText": "Максимальная покупка, за которую дают бонусы, — 100 000 ₽ (у СберПервого и Премиального 4–6 без ограничения)"
  },
  {
   "kind": "program_rule",
   "operator": null,
   "value": null,
   "originalText": "Детская СберКарта — 3 000 бонусов в месяц независимо от других продуктов"
  },
  {
   "kind": "program_rule",
   "operator": null,
   "value": null,
   "originalText": "При нескольких продуктах применяется самый выгодный"
  },
  {
   "kind": "program_rule",
   "operator": null,
   "value": null,
   "originalText": "Лимиты СпасибоТревел: 5 000 в месяц, Авиа/ЖД/Отели/Туры — по 3 000"
  },
  {
   "kind": "program_rule",
   "operator": null,
   "value": null,
   "originalText": "Начисление до 5 дней, в исключительных случаях до 40"
  },
  {
   "kind": "program_rule",
   "operator": null,
   "value": null,
   "originalText": "Нет бонусов с 6-й покупки у одного продавца за день"
  },
  {
   "kind": "program_rule",
   "operator": null,
   "value": null,
   "originalText": "Бонусы сгорают через 24 месяца без использования, через 12 месяцев без покупок, при неактивации категорий 6 месяцев"
  },
  {
   "kind": "exclusion_text",
   "operator": null,
   "value": null,
   "originalText": "Снятие наличных; оплата тарифов, подписок и пакетов Сбера, обслуживание карт, ценные бумаги"
  },
  {
   "kind": "exclusion_text",
   "operator": null,
   "value": null,
   "originalText": "Переводы, включая СБП; операции с цифровым рублём и цифровой валютой"
  },
  {
   "kind": "exclusion_text",
   "operator": null,
   "value": null,
   "originalText": "Платежи через СберБанк Онлайн; реклама; платежи по кредитам"
  },
  {
   "kind": "exclusion_text",
   "operator": null,
   "value": null,
   "originalText": "Покупки в кредит через «Покупай со Сбером»; оплата через Яндекс Сплит"
