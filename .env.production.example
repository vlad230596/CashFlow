POSTGRES_DB=cashflow
POSTGRES_USER=cashflow
POSTGRES_PASSWORD=<generate-a-long-random-password>
APP_DOMAIN=cash-flow-app.duckdns.org
APP_ORIGIN=https://cash-flow-app.duckdns.org:8443
# 1 year; active sessions are extended automatically halfway through the TTL.
CASHFLOW_SESSION_TTL_HOURS=8760
CASHFLOW_CORS_ORIGINS=
# Fernet key encrypting the ZenMoney token at rest. Generate once per environment:
#   python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
# Empty leaves card balances "not configured". Losing or changing it means re-entering the token.
CASHFLOW_SECRETS_KEY=
