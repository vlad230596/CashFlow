{
    // Use IntelliSense to learn about possible attributes.
    // Hover to view descriptions of existing attributes.
    // For more information, visit: https://go.microsoft.com/fwlink/?linkid=830387
    "version": "0.2.0",
    "configurations": [
        {
            "name": "CashFlow Backend",
            "request": "launch",
            "type": "node-terminal",
            "command": "& \"${workspaceFolder}/../backend/.venv/Scripts/python.exe\" main.py",
            "cwd": "${workspaceFolder}/../backend",
            "env": {
                "PYTHONIOENCODING": "utf-8"
            }
        },
        {
            "name": "CashFlow Frontend (Chrome)",
            "request": "launch",
            "type": "dart",
            "program": "${workspaceFolder}/lib/main.dart",
            "deviceId": "chrome"
        },
        {
            "name": "CashFlow",
            "request": "launch",
            "type": "dart"
        },
        {
            "name": "CashFlow (profile mode)",
            "request": "launch",
            "type": "dart",
            "flutterMode": "profile"
        },
        {
            "name": "CashFlow (release mode)",
            "request": "launch",
            "type": "dart",
            "flutterMode": "release"
        }
    ],
    "compounds": [
        {
            "name": "CashFlow: Backend + Frontend",
            "configurations": [
                "CashFlow Backend",
                "CashFlow Frontend (Chrome)"
            ],
            "stopAll": true
        }
    ]
}
