# Miscellaneous
*.class
*.log
*.pyc
*.swp
.DS_Store
.atom/
.build/
.buildlog/
.history
.svn/
.swiftpm/
migrate_working_dir/

# IntelliJ related
*.iml
*.ipr
*.iws
.idea/

# The .vscode folder contains launch configuration and tasks you configure in
# VS Code which you may wish to be included in version control, so this line
# is commented out by default.
#.vscode/

# Flutter/Dart/Pub related
**/doc/api/
**/ios/Flutter/.last_build_id
.dart_tool/
.flutter-plugins
.flutter-plugins-dependencies
.pub-cache/
.pub/
/build/

# Application dependency lockfile is reproducible project state and must be
# committed even though the parent repository has a broad *.lock rule.
!/pubspec.lock

# Local configuration and private signing material.
.env
.env.*
!.env.example
*.pem
*.key
*.p12
*.pfx

# Symbolication related
app.*.symbols

# Obfuscation related
app.*.map.json

# Android Studio will place build artifacts here
/android/app/debug
/android/app/profile
/android/app/release

# Local browsers, browser profiles, certificates, and diagnostic captures.
# This directory can contain cookies, authenticated sessions, and bank data.
/.local/

# Project-local development runtimes (for example portable Node.js).
/.tools/

# Browser extension build artifacts and machine-local WXT runner settings.
/browser_extension/node_modules/
/browser_extension/.output/
/browser_extension/.wxt/
/browser_extension/web-ext.config.ts
