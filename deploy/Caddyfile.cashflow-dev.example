cash-flow-app.duckdns.org:8444 {
	encode zstd gzip
	header {
		Strict-Transport-Security "max-age=31536000; includeSubDomains"
		X-Content-Type-Options "nosniff"
		X-Frame-Options "DENY"
		Referrer-Policy "no-referrer"
		Content-Security-Policy "default-src 'self'; connect-src 'self'; img-src 'self' data: blob:; font-src 'self' data:; style-src 'self' 'unsafe-inline'; script-src 'self' 'wasm-unsafe-eval'; worker-src 'self' blob:; manifest-src 'self'; frame-ancestors 'none'; base-uri 'self'; form-action 'self'"
	}

	@backend path /api/* /health /ready /version
	handle @backend {
		reverse_proxy cashflow-dev-backend:8000
	}

	handle {
		reverse_proxy cashflow-dev-frontend:8080
	}
}

