# Add this separate site block to the existing shared Caddy configuration.
# Replace the placeholder only after the CashFlow DNS A record is active.
cash-flow-app.duckdns.org:8443 {
	encode zstd gzip
	header {
		Strict-Transport-Security "max-age=31536000; includeSubDomains"
		X-Content-Type-Options "nosniff"
		X-Frame-Options "DENY"
		Referrer-Policy "no-referrer"
		Content-Security-Policy "default-src 'self'; connect-src 'self'; img-src 'self' data: blob:; font-src 'self' data:; style-src 'self' 'unsafe-inline'; script-src 'self' 'wasm-unsafe-eval'; worker-src 'self' blob:; manifest-src 'self'; frame-ancestors 'none'; base-uri 'none'; form-action 'self'"
	}

	@backend path /api/* /health /ready /version
	handle @backend {
		reverse_proxy cashflow-backend:8000
	}

	handle {
		reverse_proxy cashflow-frontend:8080
	}
}
